// Two modules in one file; the second instantiates the first, which has no variant (KL06).
kernlist_format 1;
module stage (in_valid, in_data, in_ready, out_valid, out_data, out_ready);
  input        in_valid, out_ready;
  input  [7:0] in_data;
  output       in_ready, out_valid;
  output [7:0] out_data;
  fifo #(.DEPTH(2), .W(8)) variant circular_buffer buffer (
    .enqValid(in_valid), .enqData(in_data), .enqReady(in_ready),
    .deqValid(out_valid), .deqData(out_data), .deqReady(out_ready));
endmodule

module two_stages (in_valid, in_data, in_ready, out_valid, out_data, out_ready);
  input        in_valid, out_ready;
  input  [7:0] in_data;
  output       in_ready, out_valid;
  output [7:0] out_data;
  wire         middle_valid, middle_ready;
  wire   [7:0] middle_data;
  stage first (.in_valid(in_valid), .in_data(in_data), .in_ready(in_ready),
               .out_valid(middle_valid), .out_data(middle_data), .out_ready(middle_ready));
  stage second (.in_valid(middle_valid), .in_data(middle_data), .in_ready(middle_ready),
                .out_valid(out_valid), .out_data(out_data), .out_ready(out_ready));
endmodule
