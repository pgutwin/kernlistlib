; The kernlist grammar (draft). Extends veriloglib's structural subset (verilog_subset.bnf);
; decisions in KERNLIST_decisions.md (KL03 to KL13). Notation as in verilog_subset.bnf:
; {} repetition (0 or more), [] optional, "..." literal. Comments (// and /* */) and white space
; may appear between any tokens.

<file>               ::= <format_line> <module> { <module> }
<format_line>        ::= "kernlist_format" <unsigned_decimal> ";"          ; KL03; must be 1

<module>             ::= "module" <identifier> "(" [ <port_list> ] ")" ";" { <module_item> } "endmodule"
<port_list>          ::= <identifier> { "," <identifier> }

<module_item>        ::= <declaration> ";"
                       | <continuous_assign>
                       | <instantiation>
                       | <invariant>

<declaration>        ::= ( "input" | "output" | "wire" ) [ <range> ] <id_list>     ; no inout
<id_list>            ::= <identifier> { "," <identifier> }
<range>              ::= "[" <unsigned_decimal> ":" <unsigned_decimal> "]"

<continuous_assign>  ::= "assign" <lvalue> "=" <expression> { "," <lvalue> "=" <expression> } ";"
<lvalue>             ::= <identifier> [ <select> ] | "{" <lvalue> { "," <lvalue> } "}"

; KL06: a motif instance (or an instance of another module, which has no variant)
<instantiation>      ::= <identifier> [ <parameters> ] [ "variant" <identifier> ]
                         <identifier> "(" [ <connection> { "," <connection> } ] ")" ";"
<parameters>         ::= "#" "(" <parameter> { "," <parameter> } ")"
<parameter>          ::= "." <identifier> "(" <unsigned_decimal> ")"
<connection>         ::= "." <identifier> "(" [ <expression> ] ")"       ; KL04: outputs to declared wires

; KL13: one expression language, in assign, connections and invariants. The reader accepts all
; of it; checking allows +, -, < <= > >=, unsized numbers, model(...) and -> only in invariant
; statements (KL08, KL10), and -> only as an invariant's outermost operator.
; Precedence, lowest first:  ->  ?:  |  ^  &  == !=  < <= > >=  + -  unary (~ & | ^)  primary
<expression>         ::= <choice> [ "->" <choice> ]
<choice>             ::= <or_expr> [ "?" <choice> ":" <choice> ]
<or_expr>            ::= <xor_expr> { "|" <xor_expr> }
<xor_expr>           ::= <and_expr> { "^" <and_expr> }
<and_expr>           ::= <eq_expr> { "&" <eq_expr> }
<eq_expr>            ::= <rel_expr> [ ( "==" | "!=" ) <rel_expr> ]
<rel_expr>           ::= <sum> [ ( "<" | "<=" | ">" | ">=" ) <sum> ]
<sum>                ::= <unary> { ( "+" | "-" ) <unary> }
<unary>              ::= [ "~" | "&" | "|" | "^" ] <primary>
<primary>            ::= <identifier> [ <select> ]
                       | <sized_number>
                       | <unsigned_decimal>
                       | <model_ref>
                       | "{" <expression> { "," <expression> } "}"
                       | "{" <unsigned_decimal> "{" <expression> { "," <expression> } "}" "}"
                       | "(" <expression> ")"
<select>             ::= "[" <unsigned_decimal> [ ":" <unsigned_decimal> ] "]"
<model_ref>          ::= "model" "(" <identifier> "." <identifier> [ <select> ] ")"

; KL10: invariants
<invariant>          ::= "invariant" <identifier> ":" <expression> ";"

<sized_number>       ::= <unsigned_decimal> "'" <base_char> <digits>      ; as in verilog_subset.bnf
<base_char>          ::= "b" | "B" | "o" | "O" | "d" | "D" | "h" | "H"
<unsigned_decimal>   ::= "0".."9" { "0".."9" }
<identifier>         ::= as in verilog_subset.bnf (normal or escaped)

; Lexical notes (found while checking the test set, tests/kernlists):
; - Keywords are not identifiers: module endmodule input output wire assign variant invariant
;   model protocol kernlist_format. protocol is reserved (KL20): a statement starting with it is
;   an error until protocol invariants are specified.
; - "&&" and "||" are single tokens, as in Verilog, and are not allowed anywhere: a&&b is an
;   error, not a & &b. Write a & &b (with a space) for an and with an and-reduction.
; - A decimal number followed by "'" is a <sized_number>, never an <unsigned_decimal> followed
;   by something else: in model(x.count) == 2'd1, 2'd1 is one constant.
; - "->" is one token: a->b is an implication, never a - >b.
